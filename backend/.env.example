IMPACTOS_APP_NAME="ImpactOS API"
IMPACTOS_APP_ENV=local
IMPACTOS_DEBUG=false

OTEL_SERVICE_NAME=impactos-api
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0,deployment.environment.name=local
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_PYTHON_LOG_AUTO_INSTRUMENTATION=true

OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf